# Copy to backend/.env or export as environment variables (prefix GW_)

# Data directory (defaults to ../data from backend)
# GW_DATA_DIR=~/Arthur/data

# OpenAI-compatible LLM endpoint
# llama.cpp server default:
GW_LLM_BASE_URL=http://localhost:8080/v1
GW_LLM_API_KEY=not-needed
GW_LLM_MODEL=local-model

# Ollama example:
# GW_LLM_BASE_URL=http://localhost:11434/v1
# GW_LLM_MODEL=llama3.2

# OpenAI example:
# GW_LLM_BASE_URL=https://api.openai.com/v1
# GW_LLM_API_KEY=sk-...
# GW_LLM_MODEL=gpt-4o-mini

GW_LLM_MAX_TOKENS=16384
GW_LLM_TEMPERATURE=0.7
# Max seconds to wait for the LLM to respond (large contexts on local models
# can take minutes)
GW_LLM_REQUEST_TIMEOUT=1800

# Embeddings: hash (default, fast, no torch) | st (sentence-transformers)
GW_EMBEDDING_BACKEND=hash
GW_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Audiobook example TTS engine: auto (default; Audio8 when downloaded,
# else piper) | audio8 | piper. Device: cpu (default) | cuda.
# Download the Audio8 model: python -m app.services.audio8 download
# GW_TTS_ENGINE=auto
# GW_TTS_DEVICE=cuda
